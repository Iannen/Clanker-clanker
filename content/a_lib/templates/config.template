system:
  test_command: "echo 'No tests configured' && true"
  apply_command: "echo 'No apply command configured' && true"
  
pud_filesets:
  content: { includes: [content]}

pud_domains:
  analysis:
    resolvers:
      - { anchor: project documentation, type: repo-manifest, pud_fileset: ¤ content }
    prompts:
      - name: manifest
        render:
          resolvers:
            - { anchor: prompt_fragments, type: multi-document-retrieval, files: [] }            

  files:
    resolvers:
      - { anchor: repo_content, type: repo-content, fileset: ¤ content}
    prompts:
      - name: plan
        render:
          resolvers:
            - { anchor: prompt_fragments, type: multi-document-retrieval, files: ¤ plan_mode }
      - name: impl
        render:
          resolvers:
            - {anchor: prompt_fragments, type: multi-document-retrieval, files: ¤ do_mode}

      - name: drain
        render:
          resolvers:
            - {anchor: prompt_fragments, type: multi-document-retrieval, files: ¤ doc_migration_mode}