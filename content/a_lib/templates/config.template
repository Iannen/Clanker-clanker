pud_filesets:
  content: { includes: [content]}

pud_domains:
  analysis:
    resolvers:
      - { anchor: prompt_fragments, type: multi-document-retrieval, files: [] }
      
    prompts:
      - name: manifest
        render:
          resolvers:
            - { anchor: domain_fragments, type: repo-manifest, pud_fileset: ¤ content }
      - name: files
        render:
          resolvers:
            - { anchor: repo_content, type: repo-content, fileset: ¤ content }