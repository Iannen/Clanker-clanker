system:
  test_command: "echo 'No tests configured' && true"
  apply_command: "echo 'No apply command configured' && true"
  
pud_filesets:
  content: { includes: [content]}

pud_domains:
  files:
    resolvers:
      - { anchor: repo_content, type: repo-content, content_fileset: ¤ content}
    prompts:
      - name: plan
        render:
          resolvers:
            - { anchor: session instructions, type: multi-document-retrieval, files: ¤ plan_mode }
      - name: impl
        render:
          resolvers:
            - {anchor: session instructions, type: multi-document-retrieval, files: ¤ do_mode}

      - name: drain
        render:
          resolvers:
            - {anchor: session instructions, type: multi-document-retrieval, files: ¤ doc_migration_mode}