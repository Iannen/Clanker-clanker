filesets:
  core: { includes: [content]}
  content: { includes: [content, .clanker]}

domains:
  analysis:
    resolvers:
      - { anchor: domain_fragments, type: repo-manifest, pud_fileset: content, shared_fileset: clanker-shared-assets }
    prompts:
      - name: init
        render:
          resolvers:
            - { anchor: prompt_fragments, type: multi-document-retrieval, files: [config.yaml, system_cfg.yaml, shared_cfg.yaml, config-development-mode.mode_instruction, config-dev-output.output_instruction] }
            - { anchor: repo_content, type: repo_content, fileset: empty }