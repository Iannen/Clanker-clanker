filesets:
  core: { includes: [.], excludes: [.git, .clanker] }
  content: { includes: [.], excludes: [.git, .clanker] }

domains:
  - name: analysis
    resolvers:
      - { id: domain_fragments, type: repo-manifest, pud_fileset: content, shared_fileset: clanker-shared-assets }
    prompts:
      - name: init
        render:
          resolvers:
            - { id: prompt_fragments, type: multi-document-retrieval, files: [config.yaml, system_cfg.yaml, shared_cfg.yaml, config-development-mode.md, config-dev-output.instruction] }
            - { id: repo_content, type: repo_content, fileset: empty }