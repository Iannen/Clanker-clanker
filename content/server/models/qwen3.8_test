#!/usr/bin/env fish

# Qwen 3.8 27B prefill benchmark
# RTX 4070 - matched to llama-server configuration

set -l LLAMA_BENCH "$HOME/Projects/llama.cpp/build/bin/llama-bench"
set -l MODEL_FILE "$HOME/Models/Qwen3.8-27B-GSQ-RCO-IQ3_XXS-mtp.gguf"

# Verify required files
if not test -x "$LLAMA_BENCH"
    echo "[-] llama-bench not found or not executable:"
    echo "    $LLAMA_BENCH"
    exit 1
end

if not test -f "$MODEL_FILE"
    echo "[-] Model not found:"
    echo "    $MODEL_FILE"
    exit 1
end

echo "[+] Qwen 3.8 27B - Prefill Benchmark"
echo "------------------------------------------"
echo "Model:       "(basename "$MODEL_FILE")
echo "Prompt:      512, 1024, 2048, 4096"
echo "Batch:       2048"
echo "Ubatch:      512"
echo "KV cache:    q4_0 / q4_0"
echo "Flash Attn:  on"
echo "GPU layers:  999"
echo "Repetitions: 3"
echo "------------------------------------------"

exec "$LLAMA_BENCH" \
    -m "$MODEL_FILE" \
    -p 512,1024,2048,4096 \
    -n 0 \
    -b 2048 \
    -ub 512 \
    -ctk q4_0 \
    -ctv q4_0 \
    -ngl 999 \
    -fa on \
    -r 3
