active_num_btn: "1"

rows:
  domain_row:
    primary: "1234567890"
    secondary: '!"#¤%&/()='
  prompt_row:
    primary: "qwer"
    secondary: "QWER"
  action_row:
    primary: "asdf"
    secondary: "ASDF"

symbol_sets:
  default_symbols:
    indent: "  "
    arrow_indent: "=>"
    open_tag: "<{tag} {attr}>"
    open_tag_no_attr: "<{tag}>"
    closed_tag: "</{tag}>"
    self_closing_tag: "<{tag} {attr} />"
    self_closing_no_attr: "<{tag} />"

prompt_fragments:
  general_rules:
    type: document
    path: .clanker/assets/general-rules.md
  config_development:
    type: document
    path: .clanker/assets/config_development_instructions.md
  script_dev:
    type: document
    path: .clanker/assets/script_dev_instructions.md
  debloat:
    type: document
    path: .clanker/assets/debloat_instructions.md
  backlog_doc:
    type: document
    path: .clanker/documents/backlog.md
  script_file_only:
    type: file_set
    resolver:
      sorter: path_asc
      inclusion_roots:
        - clanker.py
      exclusion_roots: []

domains:
  - name: Main script
    plan: null
    prompts:
      - name: config-dev
        symbol_set: default_symbols
        fragments:
          - general_rules
          - config_development
          - script_file_only

      - name: script-dev
        symbol_set: default_symbols
        fragments:
          - general_rules
          - script_dev
          - script_file_only

      - name: debloat
        symbol_set: default_symbols
        fragments:
          - general_rules
          - debloat
          - script_file_only

  - name: Backlog
    plan: null
    prompts:
      - name: backlog-review
        symbol_set: default_symbols
        fragments:
          - general_rules
          - backlog_doc



