- tail of clanker.py. refactor like so
'''
    try: 
        exit_msg = engine.run()
        exit_code = 0
        if is_test:
            io_adapter.end_test(exit_msg) 
        else:
            print(exit_msg)
    except TestSequenceEnded: pass
        # we simply let the app end
    except Exception as ex:
        # full traceback burger per standard python idioms, to stderr. 
'''
- 'base_classes.py': if subprocess exists 0, then we expect at least two frames. if not, then we expect last frame not to have been written by adapter, so we write it.
    - capture exit code (0 or 1) from subprocess. if 0, then proceed as normal
    - if 1, then test crashed unexpectedly. 
        -produce the final frame, injecting exit code and stderr into it. store in var in method scope for use later.
        -grab framedump file from sandbox, create the list of frames, then add the created frame to end
        -end method as normal
    - in '_run_test' prior to sending frames to test:
        - check if final frame is exit 1. if it is, then the result is a failure of the atomic test with stderr of last frame as detail, helping us see what went down inside the subprocess
Backlog tail end
Phase 3: Expectance classes / shadow classes revamp
    - only one expectance class. its job is to evaluate the frames resulting from a sequence.
        - it evaluates second to last frame for info about
            - clipboard
            - ui 
            - disk state
        - it evaluates latest frame for info about exit msg
    - all sequences produce an initial frame, not resuling from a member of the sequence, and a final frame, also not resulting from the sequence
    - in case of exit 0, the adapter produces the final frame.
    - in case of exit 1, the runner (baseclass) produces the final frame.
'''
class MyTestClass(BaseFixtureTest):
    TEMPLATE_FIXTURE_NAME = "empty_repo"
    def some_assert_scenario(self) -> list[AtomicTest]:
        return [
            AtomicTest(
                sequence=[],
                expects=Expect()
                    .ui_contains("do u wish to clankerize") # targets the second to last frame, which happens to be the initial frame because no inputs given
                    .exit_msg_is("ranouttaframes!") # our termination mechanism
            ),
            AtomicTest(
                sequence=["yes", "accept_key"],
                expects=Expect()
                    .ui_contains("bootstrap success / welcome to app or whatever") 
                    .disk_has(repocontract.getmembers)
                reset: True # subsequent reboots will go straight to UI, so we cannot reuse this sequence
            ),
            AtomicTest(
                sequence=["1"],
                expects=Expect()
                    .ui_contains("domain suchand so selected") 
                reset: False # but now we can reuse the keys. it defaults to false, but i supply so i can write comment here
            ),
            AtomicTest(
                sequence=["a"],
                expects=Expect()
                    .ui_contains("prompt suchandso") 
                    .clipboard_contains("stuff about prompt")
            ),
            AtomicTest(
                sequence=["f"],
                expects=Expect()
                    .ui_contains("no prompt on that button!") 
                    .clipboard_contains("") #isempty
            ),
            AtomicTest(
                sequence=[IOControl.escapebutton],
                expects=Expect()
                    .ui_contains("no prompt on that button!") 
                    .clipboard_contains("") #isempty
                    .exit_msg_is("user exited")
            ),
