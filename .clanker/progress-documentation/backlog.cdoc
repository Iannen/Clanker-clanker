class RuntimeConfig: # fully implemented
    keyboard: Keyboard
    ui_render: Render
    base_resolvers: [Resolver]

class Keyboard: # fully implemented
    button_map: dict[str, Button] 
    selected_key: str | None
    def get_unique_buttons
    def handle_key 

class Button: # fully implemented
    type: str
    key: str
    inhabitant: Domain | Prompt | None = None
    action: Callable | None = None
    def get_repl_map

class Domain # fully implemented
    name: str
    resolvers: [Resolver]
    prompts: [Prompt]

class Prompt:  # fully implemented
    name: str
    render: Render

class Render: # fully implemented
    template: str = "prompt_template"
    resolvers: [Resolver]
    inherit_base: bool = True
    inherit_domain: bool = True

#below stuff, not aligned / implemented I think
