'''
class RuntimeConfig:
    keyboard: Keyboard
    ui_render: Render
    base_resolvers: [Resolver]

class Keyboard:
    button_map: dict[str, Button] 
    selected_key: str | None
    def get_unique_buttons
    def handle_key 

class Button:
    type: str
    key: str
    inhabitant: Domain | Prompt | None = None
    action: Callable | None = None
    def get_repl_map

class Domain
    name: str
    resolvers: [Resolver]
    prompts: [Prompt]

class Prompt 
    name: str
    renders: [Render]

class Render -> 
    template: str = "prompt_template"
    resolvers: [Resolver]
    inherit_base: bool = True
    inherit_domain: bool = True

class Resolver:
    anchor: str
    def get_repl_map: dict[str, str]

class MultiDocResolver(Resolver):
    files: [File]

class File:
    name: str
    full_path_from_pud: bool = False
    truncation_spec: TruncationSpec

class TruncationSpec:
    # for more advanced truncation laters, for now just tailtrunc int
    tail_lines: int | None

class RepoContentResolver(Resolver):
    fileset: FileSet

class FileManifestResolver(Resolver):
    pud_fileset: Fileset
    shared_fileset: Fileset

class KBStateResolver(Resolver):

class FileSet -> to deal with filesets of repo and manifest resolver first class in domain 
    includes: [str]
    excludes: [str]
